# ==========================================
# Manga System - Environment Variables
# ==========================================

# --- Discord Bot Settings ---
DISCORD_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!
ADMIN_USER_IDS=123456789012345678,987654321098765432

# --- Web Management Panel ---
PANEL_PORT=8000
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=supersecurepassword

# --- Google Drive & Storage Integration ---
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# --- HuggingFace Infrastructure & Worker Settings ---
HF_TOKEN=hf_your_huggingface_api_token_here
HF_WORKER_URL=https://your-worker-space.hf.space
HF_WORKER_SECRET=your_hf_worker_secret_key

# --- Inpainting GPU Microservice ---
INPAINTING_API_URL=https://your-inpainting-space.hf.space
INPAINTING_API_KEY=your_inpainting_secret_key

# --- Provider Scraper & Proxy Configurations ---
FLARESOLVERR_URL=http://localhost:8191/v1
SUWAYOMI_URL=http://localhost:4567
SCRAPLING_TIMEOUT=30
