# انسخ هذا الملف إلى .env وضع القيم الصحيحة (لا ترفع .env إلى Git)

# --- Required ---
DISCORD_TOKEN=your_discord_bot_token_here
WEB_PANEL_SECRET=your_web_panel_secret_here
HF_WORKER_URL=https://your-hf-worker-url
HF_WORKER_KEY=your_hf_worker_key_or_same_as_panel_secret  # يفضّل نفس WEB_PANEL_SECRET
ALLOWED_USER_IDS=123456789,987654321

# --- Optional / Advanced ---
PROXY=http://proxy:port

# Discord IDs (اختياري)
DISCORD_GUILD_ID=your_guild_id
DISCORD_ERROR_CHANNEL_ID=your_error_channel_id

# Upload/Drive (اختياري)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOFILE_TOKEN=your_gofile_token
